---
import manifest from 'create-trokky/manifest.json'
import Configurator from '../components/Configurator.astro'

const axes = manifest.axes
const site = Astro.site?.href ?? 'https://trokky.build/'
const description =
  'Pick where it runs, where content lives and how much of the stack you want. Download a Trokky project that is ready to run — API, Studio and a site, on Cloudflare Workers or Node.'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>trokky.build — compose a Trokky project</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#183d92" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#111317" media="(prefers-color-scheme: dark)" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="trokky.build" />
    <meta property="og:title" content="Compose a Trokky project" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={site} />
    <meta property="og:image" content={`${site}og.png`} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="trokky.build — compose a Trokky project" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Compose a Trokky project" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${site}og.png`} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebApplication',
      name: 'trokky.build',
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'Any',
      url: 'https://trokky.build/',
      description: 'Compose a Trokky project: pick where it runs, where content lives and how much of the stack you want, then download it ready to run.',
      offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
      isPartOf: { '@type': 'WebSite', name: 'Trokky', url: 'https://trokky.dev/' },
    })} />

    <style is:global>
      :root {
        --ink: #17181c; --muted: #6b6f76; --line: #e3e5e8; --bg: #fbfbfc; --card: #fff;
        --accent: #183d92; --accent-2: #1c8bca; --accent-soft: #e9eff9; --off: #f4f5f7;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --ink: #e8e9ec; --muted: #9195a0; --line: #2a2d34; --bg: #111317; --card: #171a1f;
          --accent: #5aa8de; --accent-2: #1c8bca; --accent-soft: #15273e; --off: #1d2026;
        }
      }
      * { box-sizing: border-box }
      /* An author `display` rule outranks the hidden attribute's UA style, so a hidden element
         with `display: block` stays on screen. This is why the deploy button and the note
         explaining its absence were visible at the same time. */
      [hidden] { display: none !important }
      body {
        margin: 0; background: var(--bg); color: var(--ink);
        font: 16px/1.55 ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
      }
      a { color: var(--accent) }
      .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px }

      header { padding: 40px 0 0 }
      .brand {
        display: inline-flex; align-items: center; gap: 9px; text-decoration: none; color: var(--ink);
        font-weight: 600; letter-spacing: -0.01em; margin-bottom: 36px;
      }
      .brand b { font-weight: 600; color: var(--muted) }
      .brand img { display: block }
      header h1 { margin: 0 0 10px; font-size: clamp(1.7rem, 1.2rem + 1.6vw, 2.3rem); letter-spacing: -0.025em }
      .lede { margin: 0; color: var(--muted); max-width: 62ch; font-size: 1.05rem }

      main { padding: 40px 0 72px }
      footer { border-top: 1px solid var(--line); color: var(--muted); font-size: .88rem; padding: 22px 0 48px }
      footer a { text-decoration: none }
      footer a:hover { text-decoration: underline }
      code, pre { font-family: ui-monospace, SFMono-Regular, Menlo, monospace }
    </style>
  </head>
  <body>
    <header class="wrap">
      <a class="brand" href="https://trokky.dev" aria-label="Trokky">
        <img src="/logo.svg" width="24" height="27" alt="" />
        <span>trokky<b>.build</b></span>
      </a>
      <h1>Compose a Trokky project</h1>
      <p class="lede">
        Pick where it runs, where content lives, and how much of the stack you want. You get a
        project that is ready to run — not a checklist.
      </p>
    </header>

    <main class="wrap">
      <Configurator axes={axes} />
    </main>

    <footer class="wrap">
      Composed by <a href="https://github.com/Trokky/generator">create-trokky</a> in your browser —
      nothing is uploaded. <a href="https://trokky.dev">Docs</a> ·
      <a href="https://github.com/Trokky/trokky">Trokky</a> ·
      <a href="https://github.com/Trokky/build">This page</a>
    </footer>
  </body>
</html>
