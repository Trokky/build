---
interface Option { id: string; title: string; hint?: string }
interface Axis { id: string; group?: string; title: string; options: Option[] }
interface Group { id: string; title: string; hint?: string }
interface Props { groups: Group[]; axes: Axis[] }
const { groups, axes } = Astro.props

// Grouping comes from the manifest, so an axis added later lands under a heading rather than
// nowhere. Anything ungrouped still gets drawn, in its own section, rather than disappearing.
const sections = [
  ...groups.map(group => ({ group, axes: axes.filter(axis => axis.group === group.id) })),
  { group: { id: 'other', title: 'More', hint: undefined }, axes: axes.filter(axis => !groups.some(g => g.id === axis.group)) },
].filter(section => section.axes.length > 0)

let step = 0
---

<div class="wrap layout">
  <form id="configurator" novalidate>
    <div class="card intro">
      <label for="project-name">Project name</label>
      <input id="project-name" name="name" value="my-trokky-site" spellcheck="false" autocomplete="off" autocapitalize="off" />
      <p class="field-hint">Used for the folder, the package and — on Cloudflare — the Worker.</p>
    </div>

    {sections.map(section => (
      <section class="group">
        <div class="group-head">
          <h2>{section.group.title}</h2>
          {section.group.hint && <p>{section.group.hint}</p>}
        </div>

        {section.axes.map(axis => (
          <fieldset data-axis={axis.id}>
            <legend><span class="step">{++step}</span>{axis.title}</legend>
            <div class="options">
              {axis.options.map(option => (
                <label class="option" data-option={option.id}>
                  <input type="radio" name={axis.id} value={option.id} />
                  <span class="tick" aria-hidden="true"></span>
                  <span class="title">{option.title}</span>
                  {option.hint && <span class="hint">{option.hint}</span>}
                  <span class="because" hidden></span>
                </label>
              ))}
            </div>
          </fieldset>
        ))}
      </section>
    ))}
  </form>

  <aside id="result" aria-live="polite">
    <div class="panel card">
      <h2>Your project</h2>
      <ul id="summary-list"></ul>

      <div class="actions">
        <a id="deploy" class="deploy" hidden href="#" rel="noopener">
          <span>Deploy to Cloudflare</span>
          <small>One click. Cloudflare provisions D1, R2 and Images on your account.</small>
        </a>
        <button id="download" type="button">Download project</button>
        <p id="deploy-note" class="note" hidden>
          One-click deployment needs a public repository, and this composition is not one — it is
          assembled here, for you. Download it and deploy in three commands.
        </p>
      </div>

      <div class="cli">
        <div class="cli-head">
          <span>Or in a terminal</span>
          <button id="copy" type="button" aria-label="Copy command">Copy</button>
        </div>
        <code id="cli-command"></code>
      </div>
    </div>
  </aside>
</div>

<style>
  /* The panel lifts into the hero so the page opens on the thing you came to press. */
  .layout {
    display: grid; grid-template-columns: minmax(0, 1fr) 358px; gap: 56px;
    align-items: start; margin-top: -34px;
  }
  @media (max-width: 980px) { .layout { grid-template-columns: 1fr; gap: 28px; margin-top: 28px } }

  .card { background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow) }

  form { margin: 0; padding-top: 34px }
  @media (max-width: 980px) { form { padding-top: 0 } }

  .intro { padding: 20px 22px; margin-bottom: 40px }
  .intro label { display: block; font-weight: 600; margin-bottom: 8px }
  .intro input {
    width: 100%; max-width: 400px; padding: 11px 13px; font: inherit;
    border: 1px solid var(--line); border-radius: 9px; background: var(--bg); color: var(--ink);
  }
  .intro input:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px }
  .field-hint { color: var(--muted); font-size: .85rem; margin: 9px 0 0 }

  .group { margin-bottom: 44px }
  .group-head { margin-bottom: 20px; padding-bottom: 12px; border-bottom: 1px solid var(--line) }
  .group-head h2 {
    margin: 0; font-size: 1.28rem; letter-spacing: -.02em;
    background: linear-gradient(94deg, var(--navy), var(--sky));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  @media (prefers-color-scheme: dark) { .group-head h2 { background: none; color: var(--ink) } }
  .group-head p { margin: 5px 0 0; color: var(--muted); font-size: .93rem }

  fieldset { border: 0; padding: 0; margin: 0 0 26px }
  fieldset:last-child { margin-bottom: 0 }
  legend { display: flex; align-items: center; gap: 10px; font-weight: 600; padding: 0; margin-bottom: 11px }
  .step {
    display: grid; place-items: center; width: 23px; height: 23px; border-radius: 50%;
    background: var(--accent-soft); color: var(--accent); font-size: .76rem; font-weight: 700;
  }
  .options { display: grid; grid-template-columns: repeat(auto-fit, minmax(215px, 1fr)); gap: 11px }

  .option {
    position: relative; display: block; padding: 15px 17px 15px 42px; cursor: pointer;
    background: var(--card); border: 1px solid var(--line); border-radius: 11px;
    transition: border-color .12s, background .12s, box-shadow .12s;
  }
  .option:hover:not([data-unavailable]) { border-color: var(--accent); box-shadow: var(--shadow) }
  .option input { position: absolute; opacity: 0; pointer-events: none }
  .option .tick {
    position: absolute; left: 15px; top: 17px; width: 17px; height: 17px; border-radius: 50%;
    border: 1.5px solid var(--line); transition: border-color .12s, background .12s;
  }
  .option .title { display: block; font-weight: 600 }
  .option .hint { display: block; color: var(--muted); font-size: .86rem; margin-top: 3px }

  .option:has(input:checked) { border-color: var(--accent); background: var(--accent-soft) }
  .option:has(input:checked) .tick { border-color: var(--accent); background: var(--accent) }
  .option:has(input:checked) .tick::after {
    content: ""; position: absolute; inset: 0; margin: auto; width: 5px; height: 9px;
    border: solid #fff; border-width: 0 2px 2px 0; rotate: 45deg; translate: 0 -1px;
  }
  .option:has(input:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px }

  /* Unavailable is not hidden: seeing why a thing cannot be chosen is most of the value here. */
  .option[data-unavailable] { background: var(--off); cursor: not-allowed; border-style: dashed; box-shadow: none }
  .option[data-unavailable] .title, .option[data-unavailable] .hint, .option[data-unavailable] .tick { opacity: .45 }
  .option .because {
    display: block; margin-top: 9px; font-size: .84rem; line-height: 1.45;
    color: var(--muted); border-top: 1px dashed var(--line); padding-top: 9px;
  }

  /* The actions follow you down the page: the choices are long and the button is the point. */
  aside { position: sticky; top: 22px }
  @media (max-width: 980px) { aside { position: static } }
  .panel { padding: 22px }
  .panel h2 { font-size: .74rem; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); margin: 0 0 14px }
  /* The rows are written by the script, so they carry no scope attribute and a scoped rule
     never reaches them. This is why the summary read as one run-on line per row. */
  #summary-list { margin: 0 0 20px; padding: 0; list-style: none; font-size: .92rem }
  :global(#summary-list li) {
    display: flex; justify-content: space-between; align-items: baseline; gap: 14px;
    padding: 7px 0; border-bottom: 1px solid var(--line);
  }
  :global(#summary-list li:last-child) { border-bottom: 0 }
  :global(#summary-list span) { color: var(--muted); white-space: nowrap }
  :global(#summary-list b) { font-weight: 600; text-align: right }

  .deploy {
    display: block; text-decoration: none; text-align: center; margin-bottom: 10px;
    padding: 12px 18px; border-radius: 10px; background: #f6821f; color: #fff; font-weight: 600;
  }
  .deploy small { display: block; font-weight: 400; font-size: .76rem; opacity: .92; margin-top: 3px }
  #download {
    font: inherit; font-weight: 600; font-size: 1rem; padding: 14px 18px; border: 0; border-radius: 10px;
    background: linear-gradient(100deg, var(--navy), var(--sky)); color: #fff; cursor: pointer; width: 100%;
  }
  #download:hover { filter: brightness(1.08) }
  #download:disabled { opacity: .55; cursor: progress; filter: none }
  .note { color: var(--muted); font-size: .82rem; line-height: 1.5; margin: 12px 0 0 }

  .cli { margin-top: 20px; border-top: 1px solid var(--line); padding-top: 15px }
  .cli-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px }
  .cli-head span { color: var(--muted); font-size: .8rem }
  #copy {
    font: inherit; font-size: .76rem; padding: 3px 9px; border-radius: 6px; cursor: pointer;
    border: 1px solid var(--line); background: var(--off); color: var(--muted);
  }
  #copy:hover { color: var(--ink); border-color: var(--accent) }
  #cli-command {
    display: block; font-size: .76rem; line-height: 1.55; color: var(--ink);
    word-break: break-all; background: var(--off); border-radius: 8px; padding: 11px;
  }
</style>

<script>
  import { validate, optionsFor, reconcile, templateFor, withDefaults, generate, inlineFileSource, manifest } from 'create-trokky'

  const form = document.getElementById('configurator') as HTMLFormElement
  const nameInput = document.getElementById('project-name') as HTMLInputElement
  const summary = document.getElementById('summary-list') as HTMLUListElement
  const command = document.getElementById('cli-command') as HTMLElement
  const download = document.getElementById('download') as HTMLButtonElement
  const deploy = document.getElementById('deploy') as HTMLAnchorElement
  const deployNote = document.getElementById('deploy-note') as HTMLElement

  const axisIds = manifest.axes.map(axis => axis.id)

  /** What is chosen right now, as the generator's config shape. */
  function chosen(): Record<string, string> {
    const data = new FormData(form)
    return Object.fromEntries(axisIds.flatMap(id => {
      const value = data.get(id)
      return typeof value === 'string' ? [[id, value]] : []
    }))
  }

  /**
   * Redraw availability from the manifest. The page holds no rules of its own: it asks
   * `optionsFor` what is still reachable, and shows the constraint's own words for what is not.
   */
  function refresh(): void {
    // Changing one axis can invalidate several others — switching to Node leaves the Cloudflare
    // adapters selected. Settle the whole composition first, so what is drawn below is drawn
    // against a config that makes sense.
    const config = reconcile(chosen()) as Record<string, string>
    for (const [axis, value] of Object.entries(config)) {
      const input = form.querySelector<HTMLInputElement>(`[data-axis="${axis}"] [data-option="${value}"] input`)
      if (input && !input.checked) input.checked = true
    }

    for (const axis of manifest.axes) {
      const available = new Set(optionsFor(axis.id, config))

      for (const option of axis.options) {
        const label = form.querySelector<HTMLLabelElement>(`[data-axis="${axis.id}"] [data-option="${option.id}"]`)
        if (!label) continue
        const input = label.querySelector('input') as HTMLInputElement
        const because = label.querySelector('.because') as HTMLElement

        // Reachable given everything else chosen so far.
        if (available.has(option.id)) {
          label.removeAttribute('data-unavailable')
          input.disabled = false
          because.hidden = true
          continue
        }

        label.setAttribute('data-unavailable', '')
        input.disabled = true
        // Why not — in the constraint's own words, not a generic "unavailable".
        const problem = validate({ ...config, [axis.id]: option.id }).problems.find(p => p.axis === axis.id)
        because.textContent = problem?.because ?? ''
        because.hidden = !problem
      }
    }

    describe()
  }

  /** What an option is called, in the manifest's words rather than its id. */
  function titleOf(axisId: string, value: string | undefined): string {
    const option = manifest.axes.find(a => a.id === axisId)?.options.find(o => o.id === value)
    return option?.title ?? value ?? ''
  }

  function describe(): void {
    const config = reconcile(chosen()) as Record<string, string>
    // The labels are the summary's own; the values are the manifest's, so the panel says
    // "Cloudflare D1" where the page used to print the adapter id at the reader.
    const lines: [string, string][] = [
      ['Runs on', titleOf('target', config.target)],
      ['Content in', titleOf('data', config.data)],
      ['Uploads in', titleOf('media', config.media)],
      ['Thumbnails', titleOf('images', config.images)],
      ['You get', titleOf('parts', config.parts)],
      ['Starting content', titleOf('content', config.content)],
    ]
    summary.innerHTML = lines.map(([label, value]) => `<li><span>${label}</span><b>${value}</b></li>`).join('')

    const name = nameInput.value.trim() || 'my-trokky-site'
    const flags = axisIds.map(id => `--${id}=${config[id]}`).join(' ')
    command.textContent = `npm create trokky@latest ${name} -- --yes ${flags}`

    // The Deploy button needs a public repository. Exactly one composition is one; for the rest,
    // say so and give the three commands that do the same job, rather than hiding the option
    // with no explanation.
    const template = templateFor(config)
    deploy.hidden = !template
    deployNote.hidden = Boolean(template)
    if (template) deploy.href = template.deployButton
  }

  const copy = document.getElementById('copy') as HTMLButtonElement
  copy.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(command.textContent ?? '')
      copy.textContent = 'Copied'
      setTimeout(() => { copy.textContent = 'Copy' }, 1600)
    } catch {
      // Clipboard access can be refused; selecting the text is the honest fallback.
      const range = document.createRange()
      range.selectNodeContents(command)
      const selection = getSelection()
      selection?.removeAllRanges()
      selection?.addRange(range)
      copy.textContent = 'Select and copy'
      setTimeout(() => { copy.textContent = 'Copy' }, 2400)
    }
  })

  form.addEventListener('change', refresh)
  nameInput.addEventListener('input', describe)

  download.addEventListener('click', async () => {
    const name = nameInput.value.trim() || 'my-trokky-site'
    const config = withDefaults({ name, ...chosen() } as never)

    const result = validate(config)
    if (!result.valid) {
      download.textContent = 'That combination cannot be built'
      return
    }

    download.disabled = true
    download.textContent = 'Building…'
    try {
      // Loaded on demand, and the photographs only when a composition actually wants them:
      // the magazine's images and PDFs are most of the payload and most people never pick it.
      const [{ text }, { zipSync }, binaryModule] = await Promise.all([
        import('create-trokky/generated/files-text'),
        import('fflate'),
        config.content === 'magazine' ? import('create-trokky/generated/files-binary') : Promise.resolve({ binary: {} }),
      ])

      const tree = generate(config, inlineFileSource({ text, binary: binaryModule.binary }))

      const encoder = new TextEncoder()
      const entries: Record<string, Uint8Array> = {}
      for (const [path, contents] of tree) {
        entries[`${name}/${path}`] = typeof contents === 'string' ? encoder.encode(contents) : contents
      }

      // Images and PDFs are already compressed; asking again costs time and saves nothing.
      const zipped = zipSync(entries, { level: 6 })
      const url = URL.createObjectURL(new Blob([zipped], { type: 'application/zip' }))
      const link = document.createElement('a')
      link.href = url
      link.download = `${name}.zip`
      link.click()
      URL.revokeObjectURL(url)

      download.textContent = 'Downloaded — build again?'
    } catch (error) {
      console.error(error)
      download.textContent = 'Something went wrong'
    } finally {
      download.disabled = false
    }
  })

  // Start from the manifest's own defaults rather than an arbitrary first option.
  const defaults = { target: 'workers', ...manifest.defaults.workers } as Record<string, string>
  for (const [axis, value] of Object.entries(defaults)) {
    const input = form.querySelector<HTMLInputElement>(`[data-axis="${axis}"] [data-option="${value}"] input`)
    if (input) input.checked = true
  }
  refresh()
</script>
